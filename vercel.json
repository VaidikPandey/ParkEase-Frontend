{
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build -- --configuration production",
  "outputDirectory": "dist/parkease-frontend/browser",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://parkease-api-gateway.onrender.com/api/v1/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
